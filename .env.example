# Neon PostgreSQL connection string (pooled — used by the app at runtime)
# Get this from https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooler) connection — same host without "-pooler", used only for
# `prisma migrate deploy`. Pooled connections time out on the advisory lock (P1002).
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# PIN for each user (4-digit recommended)
PIN_TAEWOO=
PIN_YUJIN=
PIN_HOYOUNG=
PIN_DONGHYUN=

# Session cookie signing secret (32+ random chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 신뢰할 수 있는 리버스 프록시 홉 수 (기본 1 — Vercel 등 프록시 1개 뒤에서 동작할 때).
# 프록시 없이 직접 노출되는 자체 호스팅/Electron 환경에서는 0으로 설정하세요.
# 0이면 클라이언트가 위조 가능한 x-forwarded-for/x-real-ip를 IP 락아웃에 사용하지 않고,
# PIN별 응답 지연(백오프)으로만 무차별 대입을 늦춥니다.
TRUSTED_PROXY_COUNT=1
